# Local Vite build settings. Copy this file to .env.local before changing values.
VITE_IFEX_STRICT_FILE_TYPES=true
VITE_IFEX_MAX_FILE_MIB=25
VITE_IFEX_MAX_ACTIVE_FILES=4
VITE_IFEX_MAX_ACTIVE_MIB=64
VITE_IFEX_MAX_IMAGE_MEGAPIXELS=40
VITE_IFEX_MAX_PREVIEW_DIMENSION=2048
VITE_IFEX_STATISTICS_SAMPLE_DIMENSION=400
VITE_IFEX_MAX_EMBEDDED_THUMBNAIL_DIMENSION=1024
VITE_IFEX_MAX_PIXEL_DIMENSION=2048
VITE_IFEX_MAX_SEARCH_COPY_DIMENSION=1600
VITE_IFEX_SEARCH_COPY_JPEG_QUALITY_PERCENT=90
VITE_IFEX_PARSE_CONCURRENCY=1
VITE_IFEX_PARSE_TIMEOUT_MS=15000
VITE_IFEX_PIXEL_TIMEOUT_MS=20000
VITE_IFEX_MAX_METADATA_TAGS=2000
VITE_IFEX_MAX_METADATA_VALUE_CHARS=16384
VITE_IFEX_MAX_METADATA_TOTAL_CHARS=1048576
VITE_IFEX_ALLOW_UNSAFE_PREVIEW=false
