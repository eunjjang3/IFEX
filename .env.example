# Docker Compose host settings (not exposed to the browser).
IFEX_PORT=80
IFEX_RESTART_POLICY=unless-stopped

# Docker/Coolify runtime settings. Vite-only deployments use the same names with VITE_ prefixed.
IFEX_STRICT_FILE_TYPES=true
IFEX_MAX_FILE_MIB=25
IFEX_MAX_ACTIVE_FILES=4
IFEX_MAX_ACTIVE_MIB=64
IFEX_MAX_IMAGE_MEGAPIXELS=40
IFEX_MAX_PREVIEW_DIMENSION=2048
IFEX_STATISTICS_SAMPLE_DIMENSION=400
IFEX_MAX_EMBEDDED_THUMBNAIL_DIMENSION=1024
IFEX_MAX_PIXEL_DIMENSION=2048
IFEX_MAX_SEARCH_COPY_DIMENSION=1600
IFEX_SEARCH_COPY_JPEG_QUALITY_PERCENT=90
IFEX_PARSE_CONCURRENCY=1
IFEX_PARSE_TIMEOUT_MS=15000
IFEX_PIXEL_TIMEOUT_MS=20000
IFEX_MAX_METADATA_TAGS=2000
IFEX_MAX_METADATA_VALUE_CHARS=16384
IFEX_MAX_METADATA_TOTAL_CHARS=1048576
IFEX_ALLOW_UNSAFE_PREVIEW=false
