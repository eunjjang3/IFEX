{
  "name": "ifex",
  "private": true,
  "version": "0.1.2",
  "description": "Local-first browser and desktop image forensics with hardened parsing and re-encoded previews.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "productName": "IFEX",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop:renderer": "tsc -b && vite build --base=./",
    "desktop:dev": "node scripts/run-desktop.mjs",
    "desktop:package": "npm run build:desktop:renderer && node scripts/package-desktop.mjs",
    "desktop:package:mac:arm64": "npm run build:desktop:renderer && node scripts/package-desktop.mjs --platform=darwin --arch=arm64",
    "desktop:package:mac:x64": "npm run build:desktop:renderer && node scripts/package-desktop.mjs --platform=darwin --arch=x64",
    "desktop:package:win:x64": "npm run build:desktop:renderer && node scripts/package-desktop.mjs --platform=win32 --arch=x64",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "verify": "npm run check:licenses && npm test && npm run lint && npm run check:desktop && npm run build && npm run check:build-env",
    "check:desktop": "node --check electron/main.js && node --check electron/preload.cjs && node --check electron/urlPolicy.js && node --check scripts/run-desktop.mjs && node --check scripts/package-desktop.mjs && node --check scripts/verify-release-version.mjs",
    "check:licenses": "node scripts/generate-production-licenses.mjs --check",
    "check:build-env": "node scripts/verify-build-env-allowlist.mjs",
    "generate:licenses": "node scripts/generate-production-licenses.mjs",
    "update:lensfun": "node scripts/update-lensfun-cameras.mjs",
    "update:iptc-source-types": "node scripts/update-iptc-digital-source-types.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "^0.13.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-serif-kr": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "file-type": "^21.3.4",
    "framer-motion": "^12.43.0",
    "i18next": "^26.3.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "exifreader": "^4.42.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.77.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
